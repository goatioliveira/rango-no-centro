# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Onde achar: painel do Supabase → Project Settings → API Keys (e Data API para a URL).

# URL do projeto (ex.: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave PÚBLICA: a "Publishable key" (sb_publishable_...) ou a antiga "anon public".
# Ela pode ir para o navegador; quem protege os dados são as regras RLS do banco.
# NUNCA coloque aqui a "secret"/"service_role" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
